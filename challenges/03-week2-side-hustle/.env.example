# Copy to .env (ignored by git) and fill in. Never commit real keys.
# Read by the rcparts command (from RCPARTS_HOME) and copied into the Hermes profile by scripts/setup-profile.sh.

# Model (open weights on OpenRouter; also copied into the Hermes profile)
OPENROUTER_API_KEY=

# Database: Postgres on Tiger Cloud (service tigerdata-demo). Get the URL with: tiger db connection-string <service>
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require   # or TIGER_DATA_DB_URL

# Import service parameters (the maintainer's side hustle)
FEE_PER_KG_USD=25        # or FEE_PER_POUND_USD / FEE_PER_LB_USD (the maintainer prices per pound)
PROCESSING_PCT=12
US_ADDRESS=Your US forwarding address, City, ST ZIP
MAINTAINER_PHONE=593900000000
REPLY_LANG=es
STORE_CRAWL_DELAY_S=2
WEIGHT_UNIT=g
HERMES_SEND_CMD=hermes send
# Which clubs a member's HAVE/NEED is matched against: club | city | country (default city)
MATCH_SCOPE=city
# Optional: where members deposit for "we order it" quotes, shown with the RC-Q<id> reference
DEPOSIT_ACCOUNT=
# Optional: where receipts and the demo catalog are written (default: ./data, gitignored)
# RCPARTS_DATA_DIR=
# Optional: Hermes inbound document cache, only used when `deposit submit` gets no --file
# (default: ~/.hermes/profiles/rc-parts/cache/documents)
# HERMES_DOCUMENT_CACHE_DIR=
# Bridge allowlists (also used by `rcparts demo seed`: maintainer + one more number, first group JID)
WHATSAPP_ALLOWED_USERS=593900000000,593900000001
WHATSAPP_GROUP_ALLOWED_USERS=120363000000000000@g.us

# When the order batch runs (cron expression or "every 1h"); applied with scripts/install-cron.sh.
# Daily at 18:00 in production; hourly while testing.
ORDER_BATCH_SCHEDULE=0 18 * * *
