{
  "name": "rc-pit-companion",
  "version": "0.0.1",
  "private": true,
  "description": "Offline, voice-first setup coach and setup vault for a 1/10 touring car, running on a laptop with a local open model (Hacktoberfest 2026 Weekend Challenge: Build for a Friend)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "setup:wasm": "node scripts/copy-wasm.mjs",
    "spike": "npm run setup:wasm && HTTPS=1 vite --host",
    "kb:verify": "node scripts/verify-snapshot.mjs",
    "kb:build": "node scripts/build-kb.mjs",
    "eval:symptoms": "node scripts/eval-symptoms.mjs",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^26.6.4",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webgpu/types": "^0.1.74",
    "concurrently": "10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@libsql/client": "0.18.0",
    "@litert-lm/core": "^0.17.1",
    "@mastra/core": "1.74.0",
    "@mastra/libsql": "1.25.0",
    "@preact/signals": "2.11.3",
    "hono": "4.13.13",
    "minisearch": "7.2.0",
    "preact": "10.29.8",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  }
}
