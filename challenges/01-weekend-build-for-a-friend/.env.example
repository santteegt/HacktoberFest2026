# Optional: only needed for the Ollama fallback backend (laptop).
# Ollama binds to localhost by default. For a phone on the same hotspot you need
# OLLAMA_HOST=0.0.0.0 and OLLAMA_ORIGINS set to the app origin; see README "Backends".
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma4:e4b-it-qat
# Context window sent to Ollama. Keep it small: it bounds RAM and speeds up CPU-only machines.
# The friend's laptop is a 2019 Intel MacBook Pro (16 GB, CPU-only inference); 4096 is plenty for one coach turn.
VITE_OLLAMA_NUM_CTX=4096
# Per-machine model: E4B QAT on Apple Silicon dev machines, E2B QAT (4.3 GB) is the likely choice for the Intel laptop (measure first).
# VITE_OLLAMA_MODEL=gemma4:e2b-it-qat
