# Copy to .env (ignored by git). The server (server/config.ts) loads it at boot when present.
# Nothing here is secret: the app talks only to a local Ollama on this machine.

# Local Ollama endpoint. The browser never talks to Ollama; only the Node server does.
OLLAMA_URL=http://localhost:11434
# Per-machine model: E4B QAT on Apple Silicon dev machines; E2B QAT (4.3 GB) is the likely
# choice for the friend's CPU-only Intel laptop (measure first).
OLLAMA_MODEL=gemma4:e4b-it-qat
# OLLAMA_MODEL=gemma4:e2b-it-qat
# Context window sent to Ollama. Keep it small: it bounds RAM and speeds up CPU-only machines.
OLLAMA_NUM_CTX=4096

# Port of the local Node server (the Vite dev server proxies /api to it).
PORT=8787

# Mastra telemetry is on by default; keep it off so nothing leaves the machine.
# server/config.ts also forces this to 1 before Mastra is imported.
MASTRA_TELEMETRY_DISABLED=1

# Older names (VITE_OLLAMA_URL, VITE_OLLAMA_MODEL, VITE_OLLAMA_NUM_CTX) are still read as fallbacks.
