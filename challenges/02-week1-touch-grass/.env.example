# Copy to .env and fill in. .env is gitignored. Never paste these values into chat, issues or the DEV post.

# --- Web search (SerpApi) -------------------------------------------------
# Dashboard: https://serpapi.com/manage-api-key (free plan: 250 searches a month)
SERPAPI_API_KEY=
# Hard stop in our own code so a voice note can never burn the monthly quota
SERPAPI_MAX_PER_DAY=8

# --- Telegram (notifications, quiz results; not for private ideas) --------
# Create a bot with @BotFather and paste the token. Your numeric user id: message @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# --- Phone <-> Mac link (Tailscale) ----------------------------------------
# Shared secret the phone app sends with every upload (generate with: openssl rand -hex 24)
LEASH_UPLOAD_TOKEN=

# --- Local models (the default works on this Mac) --------------------------
# The wiki vault is chosen at install time: ops/leash-stack install --vault PATH
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Hermes (kept inside the project / VM) ----------------------------------
HERMES_HOME=./.hermes

# --- graphify: do not rewrite the global Claude skill on every run ----------
GRAPHIFY_NO_AUTO_REFRESH=1
