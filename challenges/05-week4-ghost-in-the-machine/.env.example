# Optional. Everything works without keys; keys only raise rate limits.
# Nothing loads this file by itself: copy it to .env, then `set -a; source .env; set +a` in your shell.
# Never commit the real .env.

# Data sources
EH_API_KEY=            # Ethereum History historian key, sent as x-api-key: 120 req/min instead of 20
ETH_RPC_URL=https://ethereum-rpc.publicnode.com   # state calls (code still there, balance); keyless
ETH_ARCHIVE_RPC_URL=https://eth.drpc.org          # old full blocks for the random-block picker; keyless
# ETHERSCAN_API_KEY=   # read by ghosts/config.py but not used by any source yet; leave empty

# Local model (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
GHOSTS_MODEL=gemma4:12b-it-qat
# GHOSTS_NUM_CTX=8192        # one context size for every call, capped at 16384 (so Ollama never reloads)
# GHOSTS_LLM_TIMEOUT=600     # seconds per model call

# Fix compile gate
# SOLC_0838=/path/to/solc-0.8.38   # default: ~/.solc-select/artifacts/solc-0.8.38/solc-0.8.38

# Delivery: scripts/deploy.sh. Empty = use the Vercel CLI login of this user.
VERCEL_TOKEN=

# Discord variables are not here: they belong to the Hermes profile's own env file,
# hermes/.env.example, copied to ~/.hermes/profiles/ghosts/.env (see docs/HERMES.md).
