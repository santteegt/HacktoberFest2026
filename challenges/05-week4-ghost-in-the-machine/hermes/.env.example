# Variable NAMES only. Copy to ~/.hermes/profiles/ghosts/.env and fill in there; never commit values.
# All optional: without the Discord pair the profile runs cron-only and the gallery is the delivery.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_FREE_RESPONSE_CHANNELS=
DISCORD_HOME_CHANNEL=
# Optional: unattended Vercel deploys. Empty = use the Vercel CLI login of this macOS user.
VERCEL_TOKEN=
